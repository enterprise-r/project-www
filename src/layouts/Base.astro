---
// Shared page shell: head, favicons and the title bar with the navigation.
import "../styles/palette.css";
import "../styles/theme/base.css";
import "../styles/theme/components.css";
import "../styles/bar.css";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import enterprsr from "../styles/fonts/woff2/Enterprsr-Regular.woff2?url";

interface Props {
  title: string;
  description: string;
  // The style guide is not indexed and draws no navigation bar.
  noindex?: boolean;
  header?: boolean;
}
const { title, description, noindex = false, header = true } = Astro.props;

// First link sits on the left. Every other page sits on the right.
const links = [
  { href: "/", label: "®", name: "Home" },
  { href: "/about/", label: "About" },
];
const homeLink = links[0];
const restLinks = links.slice(1);
const here = Astro.url.pathname.replace(/\/?$/, "/");
// The title in the bar is the page heading on Home only.
const Brand = here === homeLink.href ? "h1" : "div";
const logoWide = "/assets/logo-wide.svg";
const url = new URL(Astro.url.pathname, Astro.site).href;
// Link preview: built by pages/og-image.png.ts from the wide logo.
const ogImage = new URL("/og-image.png", Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0C040F">
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <title>{title}</title>
  <link rel="preload" href={enterprsr} as="font" type="font/woff2" crossorigin>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="400">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/icon-512.png">
</head>
<body>
  {header && (
    <header>
      <Brand class="brand">
        <img class="brand-logo" src={logoWide} width="320" height="61" alt="Enterprise-R">
      </Brand>
      <a class="home-btn" href={homeLink.href} aria-label={homeLink.name} aria-current={here === homeLink.href ? "page" : undefined}>{homeLink.label}</a>
      <nav aria-label="Main">
        {restLinks.length > 0 && (
          <span class="r-group">
            {restLinks.map((l) => (
              <a class="r-btn" href={l.href} aria-current={here === l.href ? "page" : undefined}>{l.label}</a>
            ))}
          </span>
        )}
      </nav>
    </header>
  )}
  <slot />
  {header && (
    <Footer />
  )}
  {header && (
    <script is:inline>
      // Home button: scrolled down, back to the top; at the top, the home page.
      document.querySelector(".home-btn").addEventListener("click", (e) => {
        if (window.scrollY > 0) { e.preventDefault(); window.scrollTo({ top: 0 }); }
      });
    </script>
  )}
  <slot name="scripts" />
</body>
</html>
