---
// Shared page shell: head, favicons, title bar, navigation and footer.
import "../styles/palette.css";
import "../styles/theme/base.css";
import "../styles/theme/components.css";
import "../styles/bar.css";
import "../styles/footer.css";
import "../styles/transition.css";
import Footer from "../components/Footer.astro";
import enterprsr from "../styles/fonts/woff2/Enterprsr-Regular.woff2?url";

interface Props {
  title: string;
  description: string;
  // Leave the page out of search engines. The style guide sets this.
  noindex?: boolean;
  // Title bar and footer. The style guide turns these off.
  header?: boolean;
  // Wallpaper, open stripes, and the same crumbs as Home. The 404 sets this.
  hero?: boolean;
}
const { title, description, noindex = false, header = true, hero = false } = Astro.props;

const here = Astro.url.pathname.replace(/\/?$/, "/");
const isHome = here === "/";
const isAbout = here === "/about/";
const isHero = hero || isHome;
// 404 is the only hero that is not Home. It keeps the home chrome and uses hyper-j.
// Class is not-found: a class named is-404 is stripped by the dev CSS transform.
const isMissing = hero && !isHome;
const crumbs = [
  { href: "/", label: "®", name: "Home", root: true },
];
// Home, 404 and About all show the About crumb (current only on /about/).
if (isHero || here === "/about/") {
  crumbs.push({ href: "/about/", label: "About", name: "About" });
}
// The title in the bar is the page heading on Home only.
const Brand = isHome ? "h1" : "div";
const url = new URL(Astro.url.pathname, Astro.site).href;
// Link preview: built by pages/og-image.png.ts from the wide logo.
const ogImage = new URL("/og-image.png", Astro.site).href;
---
<!DOCTYPE html>
<html lang="en" class:list={[isHero && "is-home", isMissing && "not-found", isAbout && "is-about"]}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0C040F">
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <title>{title}</title>
  <link rel="preload" href={enterprsr} as="font" type="font/woff2" crossorigin>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="400">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/icon-512.png">
  <script is:inline>
    // Home is the hinge. Leaving / or arriving at / slides; every other
    // same-origin hop skips the view transition and loads as usual.
    // Type chrome: both pages have the title bar and footer, so those stay
    // put and the page slides underneath. The showcase has neither.
    (function () {
      function path(url) {
        try { return new URL(url).pathname.replace(/\/?$/, "/"); }
        catch (err) { return ""; }
      }
      function isHome(url) { return path(url) === "/"; }
      function isShowcase(url) { return path(url) === "/showcase/"; }
      function tag(vt, fromURL, toURL) {
        if (!vt) return;
        if (isHome(fromURL) || isHome(toURL)) {
          if (vt.types) {
            vt.types.add("home");
            if (!isShowcase(fromURL) && !isShowcase(toURL)) vt.types.add("chrome");
          }
          return;
        }
        vt.skipTransition();
      }
      window.addEventListener("pageswap", function (e) {
        var act = e.activation;
        if (!act) return;
        tag(e.viewTransition, act.from && act.from.url, act.entry && act.entry.url);
      });
      window.addEventListener("pagereveal", function (e) {
        var act = window.navigation && window.navigation.activation;
        if (!act) return;
        tag(e.viewTransition, act.from && act.from.url, act.entry && act.entry.url);
      });
    })();
  </script>
</head>
<body>
  {header && (
    <header class="sc-nav-bar">
      <Brand class="sc-nav-logo">
        <a href="/" aria-label="Enterprise-R home">
          <img class="sc-nav-logo-wide" src="/assets/logo-wide.svg" width="320" height="61" alt="">
          <img class="sc-nav-logo-compact" src="/assets/logo-compact.svg" width="320" height="128" alt="">
        </a>
      </Brand>
      <nav class="r-crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c) => (
            <li>
              {c.root && isHome ? (
                <span class="r-btn r-crumb-root" aria-label={c.name} aria-current="page">{c.label}</span>
              ) : (
                <a
                  class:list={["r-btn", c.root && "r-crumb-root"]}
                  href={c.href}
                  aria-label={c.root ? c.name : undefined}
                  aria-current={here === c.href ? "page" : undefined}
                >{c.label}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <nav class="r-group" aria-label="Main">
        <a class="r-btn" href="/showcase/">UI of the future</a>
      </nav>
    </header>
  )}
  <slot />
  {header && (
    <Footer />
  )}
  <script>
    import "../styles/theme/guard.js";
  </script>
  {header && (
    <script is:inline>
      // Logo: scrolled down on Home, back to the top; otherwise, the home page.
      document.querySelectorAll("html.is-home .sc-nav-logo a").forEach((el) => {
        el.addEventListener("click", (e) => {
          if (location.pathname.replace(/\/?$/, "/") !== "/") return;
          if (window.scrollY > 0) { e.preventDefault(); window.scrollTo({ top: 0 }); }
        });
      });
    </script>
  )}
  <slot name="scripts" />
</body>
</html>
