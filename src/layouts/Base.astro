---
// Shared page shell: head, favicons and the top navigation.
import "../styles/palette.css";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  // The style guide is not indexed and draws its own sample bar.
  noindex?: boolean;
  header?: boolean;
}
const { title, description, noindex = false, header = true } = Astro.props;

// First link sits on the left. Every other page sits on the right.
const links = [
  { href: "/", label: "®", name: "Home" },
  { href: "/about/", label: "About" },
];
const homeLink = links[0];
const restLinks = links.slice(1);
const here = Astro.url.pathname.replace(/\/?$/, "/");
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/assets/og-image.jpg", Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0C040F">
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <title>{title}</title>
  <link rel="preload" href="/fonts/Enterprsr-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <script is:inline>
    // Colour option preview for the style guide: ?option=b|c|d, kept for this tab.
    try {
      const q = new URLSearchParams(location.search).get("option");
      if (q) sessionStorage.setItem("colour-option", q.toLowerCase());
      const o = sessionStorage.getItem("colour-option");
      if (o && /^[bcd]$/.test(o)) document.documentElement.classList.add("opt-" + o);
    } catch (e) {}
  </script>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/icon-512.png">
</head>
<body>
  {header && (
    <header>
      <nav aria-label="Main">
        <a class="nav-home" href={homeLink.href} aria-label={homeLink.name} aria-current={here === homeLink.href ? "page" : undefined}>{homeLink.label}</a>
        {restLinks.length > 0 && (
          <span class="nav-rest">
            {restLinks.map((l) => (
              <a href={l.href} aria-current={here === l.href ? "page" : undefined}>{l.label}</a>
            ))}
          </span>
        )}
      </nav>
    </header>
  )}
  <slot />
  <slot name="scripts" />
</body>
</html>
