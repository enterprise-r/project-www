---
// Self-contained homepage star field. Stars spawn just off the right edge and
// travel left. One new star about every second, with a little jitter.
---
<div class="home-stars" aria-hidden="true"></div>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const layer = document.querySelector(".home-stars");
  if (!reduced && layer) {
    const BASE_MS = 20000;
    const SPEED_JITTER = 0.05;
    const INTERVAL = 1000;
    const INTERVAL_JITTER = 300;
    const CAP = 32;
    const TRAVEL_START = "translate3d(100vw, 0, 0)";
    const TRAVEL_END = "translate3d(-2.75rem, 0, 0)";

    const live = new Set();
    let timer = 0;

    function nextInterval() {
      return INTERVAL + (Math.random() * 2 - 1) * INTERVAL_JITTER;
    }

    function spawn() {
      if (document.hidden || live.size >= CAP) return;
      const el = document.createElement("span");
      el.className = "home-star";
      el.style.top = 8 + Math.random() * 84 + "vh";
      el.style.transform = "rotate(" + (Math.random() * 10 - 5) + "deg)";
      const body = document.createElement("span");
      body.className = "home-star-body";
      el.appendChild(body);
      layer.appendChild(el);

      const duration = BASE_MS * (1 + (Math.random() * 2 - 1) * SPEED_JITTER);
      const anim = body.animate(
        [{ transform: TRAVEL_START }, { transform: TRAVEL_END }],
        { duration, easing: "linear", fill: "forwards" }
      );
      el._anim = anim;
      live.add(el);
      const drop = () => {
        live.delete(el);
        el.remove();
      };
      anim.finished.then(drop, drop);
    }

    function schedule() {
      clearTimeout(timer);
      if (document.hidden) return;
      timer = setTimeout(() => {
        spawn();
        schedule();
      }, nextInterval());
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        clearTimeout(timer);
        live.forEach((el) => el._anim && el._anim.pause());
      } else {
        live.forEach((el) => el._anim && el._anim.play());
        schedule();
      }
    });

    spawn();
    schedule();
  }
</script>

<style>
  /* Above the wallpaper, behind the home chrome and the terminal. */
  :global(html.is-home header),
  :global(html.is-home footer),
  :global(html.is-home main) {
    position: relative;
    z-index: 1;
  }

  .home-stars {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Wrapper holds the tilt and the vertical start; only the body is translated. */
  .home-star {
    position: absolute;
    left: 0;
    top: 50vh;
    width: 0;
    height: 0;
    transform-origin: 0 0;
  }

  .home-star-body {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.5px;
    height: 1.5px;
    border-radius: 50%;
    background: var(--ui-fg-bright);
    box-shadow: 0 0 1.5px 0.4px var(--ui-fg-bright);
    will-change: transform;
    transform: translate3d(100vw, 0, 0);
  }

  /* Trail is twice the previous length, on the right of the head (behind
     leftward travel), fading to transparent at the tail. */
  .home-star-body::after {
    content: "";
    position: absolute;
    left: 1.5px;
    top: 50%;
    width: 2.3rem;
    height: 1px;
    background: var(--ui-striped);
    transform: translateY(-50%);
    -webkit-mask-image: linear-gradient(to right, #000, transparent);
    mask-image: linear-gradient(to right, #000, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-stars { display: none; }
  }
</style>
