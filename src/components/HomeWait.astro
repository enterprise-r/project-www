---
// Home and 404 terminal: waiting icon, word carousel, prompt carousel.
import Motes from "./Motes.astro";
import "../styles/home.css";
import waitIcon from "../styles/theme/icons/wait.svg?url";

interface Part {
  text: string;
  tone?: string | null;
}

interface PromptPiece {
  text: string;
  brand?: boolean;
}

interface Props {
  parts: Part[];
  prompts: PromptPiece[][];
  // Screen-reader sentence, also shown when motion is reduced. Defaults to the words joined up.
  sentence?: string;
}

const { parts, prompts, sentence } = Astro.props;
const phrase = sentence ?? parts.map((p) => p.text).join(" ");
const countClass = parts.length === 3 ? "home-words home-words-3" : "home-words";
const promptMore = prompts.slice(1).map((line) => line.map((piece) => piece.text).join("")).join(". ");
const slices = ["0", "1", "2"];

// W-words colour only the first W; every other tinted item is coloured in full.
const mark = (p: Part) =>
  p.tone
    ? p.text.startsWith("W") && p.text.length > 1
      ? { tone: p.tone, letter: "W", rest: p.text.slice(1) }
      : { tone: p.tone, letter: p.text, rest: "" }
    : { tone: null, letter: p.text, rest: "" };
---
<Motes />
<main class="home">
  <div class="r-term home-wait">
    <div class="home-line">
      <img src={waitIcon} width="32" height="32" alt="">
      <p class="home-sentence">
        {sentence ? phrase : parts.map((p, i) => {
          const m = mark(p);
          return <>{i > 0 && " "}{m.tone ? <><span class={`home-w home-w-${m.tone}`}>{m.letter}</span>{m.rest}</> : m.letter}</>;
        })}
      </p>
      <span class={countClass} aria-hidden="true">
        {parts.map((p) => {
          const m = mark(p);
          return <span>{m.tone ? <><span class={`home-w home-w-${m.tone}`}>{m.letter}</span>{m.rest}</> : m.letter}</span>;
        })}
      </span>
    </div>
    <p class="r-prompt home-status">
      <span class="home-prompt-live">
        <span class="home-prompt-primary">
          {prompts[0].map((piece) => piece.brand ? <span class="home-brand">{piece.text}</span> : piece.text)}
        </span>
        {promptMore && <span class="home-prompt-more">. {promptMore}</span>}
      </span>
      <span class="home-prompts" aria-hidden="true">
        {prompts.map((line) => (
          <span class:list={["home-prompt", line.some((piece) => piece.brand) && "home-prompt-url"]}>
            {slices.map((slice) => (
              <span class="home-slice" data-slice={slice}>
                {line.map((piece) => piece.brand ? <span class="home-brand">{piece.text}</span> : piece.text)}
              </span>
            ))}
          </span>
        ))}
      </span>
    </p>
  </div>
</main>
