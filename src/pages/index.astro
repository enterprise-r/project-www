---
// ✏️ EDIT THE PAGE TEXT HERE
const page = {
  title: "Enterprise-R",
  description: "Enterprise-R is opening the way for companies to run on AI and people, working from the same book and, as never before, by the book.",
};
const words = ["Please", "Wait", "While", "We", "Work", "on", "Work", "Cards"];
const sentence = "Please Wait While We Work on Work Cards";

import Base from "../layouts/Base.astro";
import "../styles/home.css";
import waitIcon from "../styles/theme/icons/wait.svg?url";
---
<Base title={page.title} description={page.description}>
  <main class="home">
    <div class="r-term home-wait">
      <img src={waitIcon} width="32" height="32" alt="">
      <p class="home-sentence">{sentence}</p>
      <span class="home-words" aria-hidden="true">
        {words.map((w) => <span>{w}</span>)}
      </span>
    </div>
  </main>
</Base>
