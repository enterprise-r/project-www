---
const page = {
  title: "Enterprise-R",
  description: "Enterprise-R is opening the way for companies to run on AI and people, working from the same book and, as never before, by the book.",
};
const words = ["Please", "Wait", "While", "We", "Work", "on", "Work", "Cards"];
// First W of each W-word, in order: Amber, Orange, Magenta, Green (sage), Bright green.
const wTones = ["accent", "orange", "magenta", "green", "green-bright"];
let wTone = 0;
const parts = words.map((text) => (
  text.startsWith("W") ? { text, tone: wTones[wTone++] } : { text, tone: null }
));
// Prompt carousel. Enterprise-R is Enterprsr (that face only draws this word).
const prompts = [
  [{ text: "..." }],
  [{ text: "WE ARE WORKING HARD" }],
  [{ text: "WE WANT IT : WE WORD IT" }],
  [{ text: "WORK CARDS WORK IT" }],
  [
    { text: "www." },
    { text: "Enterprise-R", brand: true },
    { text: ".com" },
  ],
];

import Base from "../layouts/Base.astro";
import HomeWait from "../components/HomeWait.astro";
---
<Base title={page.title} description={page.description}>
  <HomeWait parts={parts} prompts={prompts} />
</Base>
