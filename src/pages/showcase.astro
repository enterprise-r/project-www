---
// UI showcase and style guide. Not in the nav, not indexed: open /showcase/ directly.
import Base from "../layouts/Base.astro";
import "../styles/theme/doc.css";
import "../styles/ui.css";
import palette from "../styles/palette.json";
import waitIcon from "../styles/theme/icons/wait.svg?url";

// Sample picture: the 3x1 banner (Drive assets/banners/banner-3x1.png) at 1600 px.
const banner = "https://lh3.googleusercontent.com/d/1EG6RdL2cQLBFWo_OEUmsheCx0SJd2ft9=w1600";

// Swatches come from the palette source, copied from project-branding.
const groups = palette.groups.map((g) => ({ ...g, colours: g.colours.filter((c) => c.var !== "--ui-accent") }));
const colours = palette.groups.flatMap((g) => g.colours);
const hex = (v) => colours.find((c) => c.var === v).hex;
const accent = colours.filter((c) => c.var === "--ui-accent");

// WCAG contrast from palette hex values (same math as the audit).
const _lin = (c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const _lum = (h) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255).map(_lin);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contrast = (a, b) => {
  const [hi, lo] = [_lum(hex(a)), _lum(hex(b))].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};
const wcagLevel = (ratio, kind) => {
  if (kind === "nontext") return ratio >= 3 ? "3:1" : "fail";
  if (ratio >= 7) return "AAA";
  if (ratio >= 4.5) return `AA (−${(7 - ratio).toFixed(2)})`;
  if (ratio >= 3) return "AA large";
  return "fail";
};
const wcagPairs = [
  ["Body text on Background", "--ui-fg", "--ui-bg", "text"],
  ["Body text on Lighter", "--ui-fg", "--ui-bg-lighter", "text"],
  ["Small text on Background", "--ui-fg-light", "--ui-bg", "text"],
  ["Dim / placeholder on Background", "--ui-fg-dark", "--ui-bg", "text"],
  ["Bright on Background", "--ui-fg-bright", "--ui-bg", "text"],
  ["h1 Green on Background", "--ui-green", "--ui-bg", "text"],
  ["h2 Bright on Background", "--ui-fg-bright", "--ui-bg", "text"],
  ["h3 Magenta on Background", "--ui-magenta", "--ui-bg", "text"],
  ["h4 Amber on Background", "--ui-accent", "--ui-bg", "text"],
  ["h5 Light on Background", "--ui-fg-light", "--ui-bg", "text"],
  ["h6 Dark on Background", "--ui-fg-dark", "--ui-bg", "text"],
  ["Link (Bright magenta) on Background", "--ui-magenta-bright", "--ui-bg", "text"],
  ["Button text on Orange (generic)", "--ui-bg", "--ui-orange", "text"],
  ["Primary text on Green", "--ui-bg", "--ui-green", "text"],
  ["Clear text on Bright blue", "--ui-bg", "--ui-blue-bright", "text"],
  ["Cancel text on Red", "--ui-bg", "--ui-red", "text"],
  ["Notice title info (Blue) on Lighter", "--ui-blue", "--ui-bg-lighter", "text"],
  ["Notice title ok (Green) on Lighter", "--ui-green", "--ui-bg-lighter", "text"],
  ["Notice title warn (Amber) on Lighter", "--ui-accent", "--ui-bg-lighter", "text"],
  ["Notice title error (Red) on Lighter", "--ui-red", "--ui-bg-lighter", "text"],
  ["Mark text on Blue", "--ui-bg", "--ui-blue", "text"],
  ["Field border (Dark) on Lighter", "--ui-fg-dark", "--ui-bg-lighter", "nontext"],
  ["Field border (Dark) on Background", "--ui-fg-dark", "--ui-bg", "nontext"],
  ["Active / focus line on Lighter", "--ui-border-active", "--ui-bg-lighter", "nontext"],
  ["Focus outline on Background", "--ui-fg-bright", "--ui-bg", "nontext"],
  ["Card / panel border (Dark) on Background", "--ui-fg-dark", "--ui-bg", "nontext"],
];
const wcagRows = wcagPairs.map(([label, fg, bg, kind]) => {
  const ratio = contrast(fg, bg);
  return { label, fg, bg, ratio: ratio.toFixed(2), level: wcagLevel(ratio, kind), kind };
});
---
<Base title="UI showcase · Enterprise-R" description="Enterprise-R UI style guide." noindex header={false}>
  <main class="showcase">
    <h1 class="sc-title">
      <img src="/assets/logo-wide.svg" width="320" height="61" alt="Enterprise-R">
    </h1>
    <p class="sc-subtitle">UI showcase</p>
    <p class="sc-lede"><span class="sc-aw">Dark-</span><span class="sc-brand">®</span>, the <span class="sc-brand">Enterprise-R</span> theme. Plain elements and the r- components, on the palette.</p>
    <p class="sc-lede"><span class="sc-aw">Dark-</span><span class="sc-brand">®</span> is futuristic with a hint of retro, on a fresh palette you don't often see in everyday interfaces. It is made for night mode and for night-light filters that warm the screen in the evening. Its purples and magentas carry a lot of blue, so <span class="sc-aw">Dark-</span><span class="sc-brand">®</span> changes more than most themes when the night light comes on.</p>

    <hr>
    <section class="sc-section" id="navigation">
      <h2 class="sc-label">Navigation</h2>
      <div class="sc-nav-bar r-unguarded">
        <a class="sc-nav-logo" href="/" aria-label="Enterprise-R home">
          <img class="sc-nav-logo-wide" src="/assets/logo-wide.svg" width="320" height="61" alt="">
          <img class="sc-nav-logo-compact" src="/assets/logo-compact.svg" width="320" height="128" alt="">
        </a>
        <nav class="r-crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a class="r-btn r-crumb-root" href="/" aria-label="Home">®</a></li>
            <li>
              <details class="r-menu">
                <summary class="r-btn">Docs</summary>
                <div class="r-menu-list">
                  <a class="r-btn" href="#">Guide</a>
                  <a class="r-btn" href="#">Reference</a>
                </div>
              </details>
            </li>
            <li><a class="r-btn" href="#" aria-current="page">Guide</a></li>
          </ol>
        </nav>
        <div class="sc-nav-end">
          <span class="r-group">
            <a class="r-btn" href="/">Home</a>
          </span>
          <span class="r-group">
            <details class="r-menu">
              <summary class="r-btn">Docs</summary>
              <div class="r-menu-list">
                <a class="r-btn" href="#">Guide</a>
                <a class="r-btn" href="#">Reference</a>
              </div>
            </details>
            <details class="r-menu">
              <summary class="r-btn">More</summary>
              <div class="r-menu-list">
                <a class="r-btn" href="#">Notes</a>
                <a class="r-btn" href="#">Log</a>
              </div>
            </details>
          </span>
        </div>
      </div>
      <p class="sc-note">The company logo sits in the middle of the bar: the wide lockup on a desktop, the compact lockup as the bar shrinks, still centred while everything fits on one row. When the bar wraps, the compact logo sits on the left of the top row, above the breadcrumbs, and the menus stay on the top right, with the breadcrumbs on the row below, slotted left. The logo, the root R, and the Home button are links to the site home. Parents are Magenta. The page you are on is Green (sage). The root is the lone R. A crumb can be a menu of its siblings. Focus on a crumb is a dual inner ring (dark then bright), because the slant would clip an outline. The two menus are joined in a group.</p>
    </section>

    <hr>
    <section class="sc-section" id="type">
      <h2 class="sc-label">Type</h2>
      <div class="sc-type">
        <span class="sc-cap"><b>h1</b> Audiowide, Green</span><h1>Mission control</h1>
        <span class="sc-cap"><b>h2</b> Audiowide, Bright</span><h2>A quiet view from orbit</h2>
        <span class="sc-cap"><b>h3</b> Audiowide, Magenta</span><h3>Engineering log</h3>
        <span class="sc-cap"><b>h4</b> label caps, Amber</span><h4>Surfaces</h4>
        <span class="sc-cap"><b>h5</b> label caps, Light</span><h5>Instruments</h5>
        <span class="sc-cap"><b>h6</b> label caps, Dark</span><h6>Footnotes</h6>
        <span class="sc-cap"><b>Body</b> Rajdhani 1.2rem</span><p>We build small, careful things and send them a long way. This is how body text reads on our dark background.</p>
        <span class="sc-cap"><b>Small</b></span><small>info<span class="at">@</span>enterprise-r.com · small print and captions</small>
        <span class="sc-cap"><b>Link</b></span><p>Read the <a href="#">mission notes</a> before you start.</p>
        <span class="sc-cap"><b>Mark</b></span><p>The <mark>launch window</mark> opens at dawn.</p>
        <span class="sc-cap"><b>Keys</b></span><p>Press <kbd>Ctrl</kbd> + <kbd>K</kbd> to search.</p>
        <span class="sc-cap"><b>Prompt</b></span><p><span class="r-prompt">Click or press</span></p>
        <span class="sc-cap"><b>Code</b></span><p><code>--r-text</code></p>
        <span class="sc-cap"><b>Quote</b></span><blockquote>Make it so, but make it small.</blockquote>
        <span class="sc-cap"><b>List</b></span><ul><li>Plain lists keep the body text.</li><li>Nested items indent.</li></ul>
        <span class="sc-cap"><b>Definitions</b></span><dl><dt>Orbit</dt><dd>The path around a body.</dd><dt>Root</dt><dd>The lone R, <span class="sc-brand">®</span>.</dd></dl>
        <span class="sc-cap"><b>Details</b></span><details><summary>Show the checklist</summary>Fuel, comms, crew.</details>
      </div>
      <p class="sc-note">Headings use Audiowide down to h3, then Rajdhani label caps. One variable per tier switches the font: <code>--r-font-heading</code> (h1, and h2 to h3 unless set apart), <code>--r-font-sub</code> (h2 to h3) and <code>--r-font-minor</code> (h4 to h6). Set one to <code>var(--r-font-text)</code> to turn Audiowide off there, or <code>--r-font-minor</code> to <code>var(--r-font-heading)</code> for more Audiowide.</p>
    </section>

    <hr>
    <section class="sc-section" id="scales">
      <h2 class="sc-label">Web and document</h2>
      <div class="sc-grid cols-2 sc-scales">
        <div>
          <p class="sc-cap"><b>Web</b> <code>base.css</code></p>
          <div>
            <h1>Mission control</h1>
            <h2>A quiet view from orbit</h2>
            <h3>Engineering log</h3>
            <p><span class="sc-aw">Dark-</span><span class="sc-brand">®</span> is futuristic with a hint of retro, on a fresh palette you don't often see in everyday interfaces. It is made for night mode and for night-light filters that warm the screen in the evening. Its purples and magentas carry a lot of blue, so <span class="sc-aw">Dark-</span><span class="sc-brand">®</span> changes more than most themes when the night light comes on.</p>
            <p><code>--r-text</code></p>
            <pre><code>:root {"{"}
  --r-text: var(--ui-fg);
{"}"}</code></pre>
          </div>
        </div>
        <div>
          <p class="sc-cap"><b>Document</b> <code>.r-doc</code> in <code>doc.css</code></p>
          <div class="r-doc">
            <h1>Mission control</h1>
            <h2>A quiet view from orbit</h2>
            <h3>Engineering log</h3>
            <p><span class="sc-aw">Dark-</span><span class="sc-brand">®</span> is futuristic with a hint of retro, on a fresh palette you don't often see in everyday interfaces. It is made for night mode and for night-light filters that warm the screen in the evening. Its purples and magentas carry a lot of blue, so <span class="sc-aw">Dark-</span><span class="sc-brand">®</span> changes more than most themes when the night light comes on.</p>
            <p><code>--r-text</code></p>
            <pre><code>:root {"{"}
  --r-text: var(--ui-fg);
{"}"}</code></pre>
          </div>
        </div>
      </div>
      <p class="sc-note">The web scale is the default. The document scale is for long text: Audiowide for h1 only, Rajdhani for h2 and h3, Saira for the body. Code is Monaspace Neon in both, <code>--r-font-mono</code>.</p>
    </section>

    <hr>
    <section class="sc-section" id="buttons">
      <h2 class="sc-label">Buttons and pills</h2>
      <div class="sc-states">
        <figure><a class="r-btn" href="#">Other</a><figcaption class="sc-cap">Generic</figcaption></figure>
        <figure><a class="r-btn is-hover" href="#">Other</a><figcaption class="sc-cap">Generic, hover</figcaption></figure>
        <figure><a class="r-btn is-focus" href="#">Other</a><figcaption class="sc-cap">Generic, focus</figcaption></figure>
        <figure><a class="r-btn" href="#" aria-current="page">Current</a><figcaption class="sc-cap">Current page</figcaption></figure>
        <figure><a class="r-btn is-hover" href="#" aria-current="page">Current</a><figcaption class="sc-cap">Current, hover</figcaption></figure>
        <figure><button class="r-btn r-primary" type="button">Send</button><figcaption class="sc-cap">Primary</figcaption></figure>
        <figure><button class="r-btn r-primary is-hover" type="button">Send</button><figcaption class="sc-cap">Primary, hover</figcaption></figure>
        <figure><a class="r-btn r-clear" href="#">Clear</a><figcaption class="sc-cap">Clear</figcaption></figure>
        <figure><a class="r-btn r-clear is-hover" href="#">Clear</a><figcaption class="sc-cap">Clear, hover</figcaption></figure>
        <figure><button class="r-btn" type="reset">Reset</button><figcaption class="sc-cap">Reset</figcaption></figure>
        <figure><button class="r-btn r-cancel" type="button">Cancel</button><figcaption class="sc-cap">Cancel</figcaption></figure>
        <figure><button class="r-btn r-cancel is-hover" type="button">Cancel</button><figcaption class="sc-cap">Cancel, hover</figcaption></figure>
        <figure><a class="r-btn r-wait" aria-disabled="true">Off</a><figcaption class="sc-cap">Disabled</figcaption></figure>
        <figure><button class="r-btn r-wait" type="button" disabled>Off</button><figcaption class="sc-cap">Disabled button</figcaption></figure>
      </div>
      <p class="sc-note">No role class is Generic: Orange, Amber (Accent) on hover. The current page and <code>.r-primary</code> are Green (sage), Bright green on hover. <code>.r-clear</code>, and any reset button, is Bright blue. <code>.r-cancel</code> is Red. Keyboard focus is a 2px Bright foreground outline (<code>--r-focus</code>, 3px off).</p>
      <p class="sc-note" id="contrast">Label contrast: …</p>
      <h3 class="sc-subhead">Group</h3>
      <p class="sc-note">Joined into one pill. The first and last ends are semicircles.</p>
      <span class="r-group">
        <a class="r-btn" href="#">Docs</a>
        <a class="r-btn" href="#" aria-current="page">About</a>
        <a class="r-btn" href="#">Log</a>
      </span>
      <h3 class="sc-subhead">Status pills</h3>
      <div class="sc-states">
        <span class="r-pill">Standby</span><span class="r-pill r-primary">Online</span><span class="r-pill r-clear">Draft</span><span class="r-pill r-cancel">Offline</span>
      </div>
      <p class="sc-note"><code>.r-pill</code> takes the button roles: Generic Orange, <code>.r-primary</code> Green, <code>.r-clear</code> Bright blue, <code>.r-cancel</code> Red.</p>
    </section>

    <hr>
    <section class="sc-section" id="cards">
      <h2 class="sc-label">Cards and panels</h2>
      <div class="sc-grid cols-3">
        <div class="r-card"><h3>Card</h3><p>Lighter background with an inactive border. The default container.</p><span class="r-pill r-primary">Online</span></div>
        <div class="r-card r-active"><h3>Active</h3><p><code>.r-active</code>: an Active border for the item in focus, or selected by the user.</p><span class="r-pill">Standby</span></div>
        <div class="r-card r-selected"><h3>Selection</h3><p><code>.r-selected</code>, for a highlighted row or a chosen card: Border fill with an Active outline.</p></div>
      </div>
      <p class="sc-note"><code>.r-panel</code> is the plain box on the page background, as around the form below.</p>
    </section>

    <hr>
    <section class="sc-section" id="notifications">
      <h2 class="sc-label">Notifications and update glow</h2>
      <div class="sc-grid cols-2">
        <div class="r-notice" id="glow-a" role="status"><strong>Notification</strong> Docking is complete. All crew aboard.</div>
        <div class="r-notice r-ok" id="glow-b" role="status"><strong>Saved</strong> Your changes are on board.</div>
        <div class="r-notice r-warn" id="glow-c" role="status"><strong>Warning</strong> Shield power dropped to 40%.</div>
        <div class="r-notice r-error" id="glow-d" role="alert"><strong>Live value</strong> Speed <b id="glow-v">0.72</b> c, over the limit.</div>
      </div>
      <div class="sc-glow-actions">
        <span class="r-group">
          <button class="r-btn" type="button" data-glow="r-glow">Glow at once</button>
          <button class="r-btn" type="button" data-glow="r-glow-run">Glow around</button>
        </span>
      </div>
      <p class="sc-note"><code>.r-notice</code> is information (Blue); <code>.r-ok</code> Green, <code>.r-warn</code> Amber, <code>.r-error</code> Red. <code>.r-glow</code> lights the whole border in the striped gradient and fades. <code>.r-glow-run</code> sends a band of the stripe once around the border. Add the class to play it; with reduced motion both are a plain fade.</p>
    </section>

    <hr>
    <section class="sc-section" id="form">
      <h2 class="sc-label">Form</h2>
      <form onsubmit="return false">
        <div class="sc-form">
          <div class="sc-field"><label for="f-name">Name</label><input id="f-name" placeholder="Jean-Luc"></div>
          <div class="sc-field"><label for="f-mail">E-mail (focus)</label><input class="is-focus" id="f-mail" type="email" value="crew@enterprise-r.com"></div>
          <div class="sc-field"><label for="f-dis">Ship ID (disabled)</label><input id="f-dis" class="r-wait" value="NCC-1701-R" disabled></div>
          <div class="sc-field"><label for="f-sel">Department</label><select id="f-sel"><option>Engineering</option><option>Science</option><option>Command</option></select></div>
          <div class="sc-field sc-span-2"><label for="f-msg">Message</label><textarea id="f-msg" placeholder="Your message"></textarea></div>
          <div class="sc-field"><span class="sc-cap">Options</span><div class="sc-checks"><label><input type="checkbox" checked> Updates</label><label><input type="checkbox"> Newsletter</label></div></div>
          <div class="sc-field"><span class="sc-cap">Channel</span><div class="sc-checks"><label><input type="radio" name="ch" checked> E-mail</label><label><input type="radio" name="ch"> Subspace</label></div></div>
          <fieldset class="r-rows">
            <legend>Team members</legend>
            <div class="r-rows-head" aria-hidden="true"><span></span><span>Name</span><span>Role</span></div>
            <div class="r-rows-list">
              <div class="r-row">
                <span class="r-row-bubble"><button type="button" class="r-row-remove" aria-label="Remove row 1"><span class="r-row-glyph" aria-hidden="true">×</span></button></span>
                <input data-name="team[{i}][name]" data-label="Name, row {n}" name="team[0][name]" value="Beverly Crusher" placeholder="Name" autocomplete="off">
                <input data-name="team[{i}][role]" data-label="Role, row {n}" name="team[0][role]" value="Chief medical officer" placeholder="Role" autocomplete="off">
              </div>
              <div class="r-row">
                <span class="r-row-bubble"><button type="button" class="r-row-remove" aria-label="Remove row 2"><span class="r-row-glyph" aria-hidden="true">×</span></button></span>
                <input data-name="team[{i}][name]" data-label="Name, row {n}" name="team[1][name]" value="Geordi La Forge" placeholder="Name" autocomplete="off">
                <input data-name="team[{i}][role]" data-label="Role, row {n}" name="team[1][role]" value="Chief engineer" placeholder="Role" autocomplete="off">
              </div>
            </div>
            <div class="r-rows-foot">
              <span class="r-row-bubble"><button type="button" class="r-row-add" aria-label="Add row"><span class="r-row-glyph" aria-hidden="true">+</span></button></span>
              <div class="r-row-ghost" aria-hidden="true">
                <input placeholder="Name" disabled tabindex="-1" aria-hidden="true" autocomplete="off">
                <input placeholder="Role" disabled tabindex="-1" aria-hidden="true" autocomplete="off">
              </div>
            </div>
            <p class="r-rows-live r-vh" aria-live="polite"></p>
          </fieldset>
          <div class="sc-actions"><span class="r-group"><button class="r-btn r-primary" type="submit">Send</button><button class="r-btn" type="button">Save</button><button class="r-btn" type="reset">Clear</button><button class="r-btn r-cancel" type="button">Cancel</button></span><span class="sc-help">Primary Green (sage), Generic Orange, Clear Bright blue, Cancel Red.</span></div>
        </div>
      </form>
      <p class="sc-note">A dynamic list in the form: add or remove rows of name and role. The control is quiet until you need it. <code>.r-rows</code> in the theme, with <code>theme/rows.js</code>.</p>
    </section>

    <hr>
    <section class="sc-section" id="working">
      <h2 class="sc-label">Working</h2>
      <div class="r-card sc-working" role="status">
        <img src={waitIcon} width="32" height="32" alt="">
        <span>Working</span>
      </div>
      <p class="sc-note">Wait while we work. Every disabled control uses the W cursor. A button accepts a click after the pointer stops, for ten seconds, and goes off briefly after a click; a discarded click flashes the W until it can be clicked.</p>
    </section>

    <hr>
    <section class="sc-section" id="tables">
      <h2 class="sc-label">Tables</h2>
      <table>
        <caption>Crew on this watch</caption>
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th class="r-num">Watch</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Beverly Crusher</td>
            <td>Chief medical officer</td>
            <td class="r-num">1</td>
          </tr>
          <tr>
            <td>Geordi La Forge</td>
            <td>Chief engineer</td>
            <td class="r-num">2</td>
          </tr>
        </tbody>
      </table>
      <p class="sc-note">A plain table: rounded outline, header row on the Border fill, dividers between rows, Lighter background on hover. <code>.r-num</code> right-aligns the number column.</p>
    </section>

    <hr>
    <section class="sc-section" id="groups">
      <h2 class="sc-label">Groups, progress and dialog</h2>
      <div class="sc-grid cols-2">
        <fieldset>
          <legend>Crew</legend>
          <div class="sc-checks"><label><input type="checkbox" checked> Captain</label><label><input type="checkbox"> Pilot</label><label><input type="radio" name="sc-r" checked> Day</label><label><input type="radio" name="sc-r"> Night</label></div>
        </fieldset>
        <div class="sc-meters">
          <span class="sc-cap"><b>Progress</b></span><progress value="62" max="100">62%</progress>
          <span class="sc-cap"><b>Meter</b> good</span><meter value="0.8" low="0.3" high="0.6" optimum="1">80%</meter>
          <span class="sc-cap"><b>Meter</b> fair</span><meter value="0.5" low="0.3" high="0.6" optimum="1">50%</meter>
          <span class="sc-cap"><b>Meter</b> poor</span><meter value="0.2" low="0.3" high="0.6" optimum="1">20%</meter>
        </div>
      </div>
      <p class="sc-dialog-open"><span class="r-group"><button class="r-btn" type="button" onclick="document.getElementById('sc-dialog').showModal()">Open dialog</button></span></p>
      <dialog id="sc-dialog">
        <h3>Leave orbit?</h3>
        <p>A dialog is a card over the dimmed page.</p>
        <form method="dialog" class="sc-dialog-actions"><span class="r-group"><button class="r-btn r-clear">Stay</button><button class="r-btn r-primary">Leave</button></span></form>
      </dialog>
      <p class="sc-note">A plain fieldset, legend, progress (striped gradient), meter (Green, Yellow, Red by its low and high marks) and dialog. Pictures scale down to their container.</p>
    </section>

    <hr>
    <section class="sc-section" id="terminal">
      <h2 class="sc-label">Terminal</h2>
      <figure class="sc-term-sample">
        <div class="sc-bd"><div class="photo" style={`background-image: url(${banner})`}></div><div class="sc-term-stack"><div class="r-term term-head"><div class="about-heading">Heading</div></div><div class="r-term"><p style="margin:0">Terminal panel: a small dark backing ({hex("--ui-bg")} at 72%) that hugs a block of text on a picture, with a thin inactive border and a soft blur.</p></div></div></div>
        <figcaption class="sc-cap">Terminal panel, for text over a picture</figcaption>
      </figure>
    </section>

    <hr>
    <section class="sc-section" id="code">
      <h2 class="sc-label">Code</h2>
      <pre><code><span class="k">:root</span> {"{"}
  <span class="k">--r-primary</span>: <span class="v">var(--ui-green)</span>;         <span class="c">/* Green (sage) {hex("--ui-green")} */</span>
  <span class="k">--r-primary-hover</span>: <span class="v">var(--ui-green-bright)</span>; <span class="c">/* Bright green {hex("--ui-green-bright")} */</span>
  <span class="k">--r-btn</span>: <span class="v">var(--ui-orange)</span>;              <span class="c">/* Orange {hex("--ui-orange")} */</span>
  <span class="k">--r-btn-hover</span>: <span class="v">var(--ui-accent)</span>;        <span class="c">/* Amber (Accent) {hex("--ui-accent")} */</span>
  <span class="k">--r-text</span>: <span class="v">var(--ui-fg)</span>;                <span class="c">/* {hex("--ui-fg")} */</span>
{"}"}</code></pre>
    </section>

    <hr>
    <section class="sc-section" id="separators">
      <h2 class="sc-label">Separators</h2>
      <hr class="sc-sep">
      <span class="sc-cap">Separator (--ui-separator): Green (sage) at the faded edges, through Magenta, to Orange in the centre</span>
      <div class="sc-striped-thin"></div>
      <span class="sc-cap">Striped rule (--ui-striped): Orange, Magenta, Green (sage), bottom left to top right</span>
      <div class="sc-striped" style="margin-top:1.2rem"></div>
      <span class="sc-cap">Striped gradient: the badge ring and the words of the wide and compact logos</span>
    </section>

    <hr>
    <section class="sc-section" id="palette">
      <h2 class="sc-label">Palette</h2>
      <div class="sc-brand-box">
        <h3 class="sc-subhead" style="margin-top:0">Amber (Accent)</h3>
        <div class="sc-swatches">
          {accent.map((c) => (
            <div class="sc-swatch"><i style={`background:var(${c.var})`}></i><div><b>{c.name}</b><code>{c.hex}</code><small>{c.var} · {c.use}</small></div></div>
          ))}
        </div>
      </div>
      {groups.map((g) => (<>
        <h3 class="sc-subhead">{g.title}</h3>
        <div class="sc-swatches">
          {g.colours.map((c) => (<div class="sc-swatch"><i style={`background:var(${c.var})`}></i><div><b>{c.name}</b><code>{c.hex}</code><small>{c.var}{c.use && ` · ${c.use}`}</small></div></div>))}
        </div>
      </>))}
    </section>

    <hr>
    <section class="sc-section" id="accessibility">
      <h2 class="sc-label">Accessibility</h2>
      <p><span class="sc-aw">Dark-</span><span class="sc-brand">®</span> meets WCAG 2.2 AA throughout and is effectively AAA most of the time. The few exceptions are intentional and only used when visibility is not the priority. <span class="sc-aw">Dark-</span><span class="sc-brand">®</span> is meant to be easy on the eyes and optimized for fast use.</p>
      <p>Borders and focus rings clear 3:1. Links are underlined, targets are at least 24px, motion stops when you ask for less, and high-contrast mode keeps every edge visible.</p>
      <table>
        <caption>Contrast scores for <span class="sc-aw">Dark-</span><span class="sc-brand">®</span></caption>
        <thead>
          <tr>
            <th>Pair</th>
            <th class="r-num">Ratio</th>
            <th>WCAG</th>
          </tr>
        </thead>
        <tbody>
          {wcagRows.map((row) => (
            <tr>
              <td>
                <span class="sc-chip" aria-hidden="true">
                  <i style={`background:var(${row.fg})`}></i>
                  <i style={`background:var(${row.bg})`}></i>
                </span>
                {row.label}
              </td>
              <td class="r-num">{row.ratio}:1</td>
              <td>{row.level}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="sc-note">Ratios are computed from the palette hex values. <code>.r-num</code> right-aligns the ratio column.</p>
    </section>

    <p class="sc-closer" aria-hidden="true"><span class="sc-closer-fill"><span class="sc-aw">Dark-</span><span class="sc-brand">®</span></span></p>

  </main>
  <footer><p class="sc-brand">Enterprise-R</p></footer>
  <script>
    import "../styles/theme/rows.js";
  </script>
  <script is:inline slot="scripts">
    // Menus: one open at a time; click outside or Esc closes them. The theme leaves that to the page.
    (() => {
      const menus = [...document.querySelectorAll("details.r-menu")];
      const close = (keep) => menus.forEach((m) => { if (m !== keep) m.open = false; });
      menus.forEach((m) => m.addEventListener("toggle", () => { if (m.open) close(m); }));
      document.addEventListener("click", (e) => { if (!e.target.closest("details.r-menu")) close(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    })();
    // Label contrast, from the colours on screen.
    (() => {
      const probe = document.body.appendChild(document.createElement("span"));
      const cs = getComputedStyle(document.documentElement);
      const hex = (v) => {
        const m = v.trim().match(/^#([0-9a-f]{6})$/i);
        if (m) return "#" + m[1].toUpperCase();
        const r = v.match(/rgba?\(([^)]+)\)/);
        if (!r) return v.trim();
        return "#" + r[1].split(",").slice(0, 3).map((n) => Math.round(parseFloat(n)).toString(16).padStart(2, "0")).join("").toUpperCase();
      };
      const lum = (h) => { const c = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255).map((x) => (x <= 0.04045 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4)); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
      const ratio = (a, b) => { const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p); return ((x + 0.05) / (y + 0.05)).toFixed(1); };
      const v = (t) => {
        const raw = cs.getPropertyValue(t).trim();
        if (raw.startsWith("var(")) { probe.style.color = raw; return hex(getComputedStyle(probe).color); }
        return hex(raw);
      };
      const label = v("--r-btn-text");
      document.getElementById("contrast").textContent =
        `Label contrast (WCAG AA needs 4.5:1): on current ${ratio(label, v("--r-primary"))}:1, on other ${ratio(label, v("--r-btn"))}:1, ` +
        `on current hover ${ratio(label, v("--r-primary-hover"))}:1, on other hover ${ratio(label, v("--r-btn-hover"))}:1, ` +
        `on clear ${ratio(label, v("--r-clear"))}:1 (hover ${ratio(label, v("--r-clear-hover"))}:1), on cancel ${ratio(label, v("--r-cancel"))}:1 (hover ${ratio(label, v("--r-cancel-hover"))}:1). ` +
        `Body text on the page background ${ratio(v("--r-text"), v("--ui-bg"))}:1.`;
      probe.remove();
    })();
  </script>
  <script>
    // Replay an update glow on a box: remove the class, force a reflow, add it back.
    function rGlow(el, kind) {
      el.classList.remove("r-glow", "r-glow-run");
      void el.offsetWidth;
      el.classList.add(kind);
    }
    document.querySelectorAll("[data-glow]").forEach((b) => b.addEventListener("click", () => {
      const v = document.getElementById("glow-v");
      v.textContent = (0.5 + Math.random() * 0.49).toFixed(2);
      ["glow-a", "glow-b", "glow-c", "glow-d"].forEach((id) => rGlow(document.getElementById(id), b.dataset.glow));
    }));

  </script>
</Base>
