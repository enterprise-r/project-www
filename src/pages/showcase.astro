---
// UI showcase and style guide. Not in the nav, not indexed: open /showcase/ directly.
import Base from "../layouts/Base.astro";
import "../styles/ui.css";
import palette from "../styles/palette.json";

// Sample picture: the 3x1 banner (Drive assets/banners/banner-3x1.png) at 1600 px.
const banner = "https://lh3.googleusercontent.com/d/1EG6RdL2cQLBFWo_OEUmsheCx0SJd2ft9=w1600";

// Swatches come from the palette source, copied from project-branding.
const groups = palette.groups.map((g) => ({ ...g, colours: g.colours.filter((c) => c.var !== "--ui-accent") }));
const colours = palette.groups.flatMap((g) => g.colours);
const hex = (v) => colours.find((c) => c.var === v).hex;
const accent = colours.filter((c) => c.var === "--ui-accent");
---
<Base title="UI showcase · Enterprise-R" description="Enterprise-R UI style guide." noindex header={false}>
  <main class="showcase">
    <h1 class="sc-title sc-title-brand">Enterprise-R</h1>
    <p class="sc-subtitle">UI showcase</p>
    <p class="sc-lede">Our style guide in one place. Interface parts use the Enterprise-R palette, with Amber (Accent) as the accent.</p>

    <section class="sc-section">
      <h2 class="sc-label">Buttons</h2>
      <div class="sc-states">
        <figure><span class="bar-group"><a class="bar-btn" href="#">Other</a></span><figcaption class="sc-cap">Other</figcaption></figure>
        <figure><span class="bar-group"><a class="bar-btn is-hover" href="#">Other</a></span><figcaption class="sc-cap">Other, hover</figcaption></figure>
        <figure><span class="bar-group"><a class="bar-btn is-focus" href="#">Other</a></span><figcaption class="sc-cap">Other, focus</figcaption></figure>
        <figure><span class="bar-group"><a class="bar-btn" href="#" aria-current="page">Current</a></span><figcaption class="sc-cap">Current</figcaption></figure>
        <figure><span class="bar-group"><a class="bar-btn is-hover" href="#" aria-current="page">Current</a></span><figcaption class="sc-cap">Current, hover</figcaption></figure>
        <figure><span class="bar-group"><a class="bar-btn is-focus" href="#" aria-current="page">Current</a></span><figcaption class="sc-cap">Current, focus</figcaption></figure>
        <figure><span class="bar-group"><a class="bar-btn" aria-disabled="true">Off</a></span><figcaption class="sc-cap">Disabled</figcaption></figure>
      </div>
      <p class="sc-note">Hover switches the fill: other buttons from Orange to Amber (Accent), current buttons from Green (sage) to Bright green. Keyboard focus is a 2 px Bright foreground outline (--nav-focus, 3 px off) on every button and link.</p>
      <p class="sc-note" id="contrast">Label contrast: …</p>
    </section>

    <section class="sc-section">
      <h2 class="sc-label">Navigation</h2>
      <div class="sc-nav-samples">
        <div class="sc-bar end">
          <nav class="bar-group" aria-label="Sample navigation">
            <a class="bar-btn" href="#">About</a>
            <details class="bar-menu">
              <summary class="bar-btn">Docs</summary>
              <div class="bar-menu-list">
                <a class="bar-btn" href="#">Guides</a>
                <a class="bar-btn" href="#">Reference</a>
                <a class="bar-btn" href="#">Changelog</a>
              </div>
            </details>
            <a class="bar-btn" href="#" aria-current="page">Showcase</a>
          </nav>
        </div>
        <span class="sc-cap">Nav buttons with a menu: Docs opens a list of its pages</span>
      </div>
      <div class="sc-nav-samples" style="margin-top:1.2rem">
        <div class="sc-bar on-page">
          <nav class="crumbs" aria-label="Sample breadcrumb">
            <ol>
              <li><a class="bar-btn crumb-root" href="#" aria-label="Home">®</a></li>
              <li><a class="bar-btn" href="#">Docs</a></li>
              <li>
                <details class="bar-menu to-right">
                  <summary class="bar-btn" aria-current="page">Guides</summary>
                  <div class="bar-menu-list">
                    <a class="bar-btn" href="#" aria-current="page">Guides</a>
                    <a class="bar-btn" href="#">Reference</a>
                    <a class="bar-btn" href="#">Changelog</a>
                  </div>
                </details>
              </li>
            </ol>
          </nav>
        </div>
        <span class="sc-cap">Breadcrumbs with a sibling switch: the page you are on opens its siblings</span>
      </div>
      <p class="sc-note">Breadcrumbs are the nav buttons joined in one row on a diagonal, one per level, with only the last rounded on the right. The root is the lone R (®) in Enterprsr, our mark for the root of the content. Parents are links, so they are Magenta (Bright magenta on hover); the page you are on is Green (sage). Labels keep their colour on hover; a crumb shows keyboard focus as an inner ring. Any nav button or crumb can carry a menu: a caret on the left of the button, which takes its hover colour while open, and a stack of the same squared buttons on the title bar colour underneath. Click outside or press Esc to close it.</p>
    </section>

    <section class="sc-section">
      <h2 class="sc-label">Separators</h2>
      <hr class="sc-sep">
      <span class="sc-cap">Separator (--ui-separator): Green (sage) at the faded edges, through Magenta, to Orange in the centre</span>
      <div class="sc-striped-thin"></div>
      <span class="sc-cap">Striped rule (--ui-striped): Orange, Magenta, Green (sage), bottom left to top right</span>
      <div class="sc-striped" style="margin-top:1.2rem"></div>
      <span class="sc-cap">Striped gradient: the badge ring and the words of the wide and compact logos</span>
    </section>

    <section class="sc-section">
      <h2 class="sc-label">Colours</h2>
      <div class="sc-brand-box">
        <h3 class="sc-subhead" style="margin-top:0">Amber (Accent)</h3>
        <div class="sc-swatches">
          {accent.map((c) => (
            <div class="sc-swatch"><i style={`background:var(${c.var})`}></i><div><b>{c.name}</b><code>{c.hex}</code><small>{c.var} · {c.use}</small></div></div>
          ))}
        </div>
      </div>
      {groups.map((g) => (<>
        <h3 class="sc-subhead">{g.title}</h3>
        <div class="sc-swatches">
          {g.colours.map((c) => (<div class="sc-swatch"><i style={`background:var(${c.var})`}></i><div><b>{c.name}</b><code>{c.hex}</code><small>{c.var}{c.use && ` · ${c.use}`}</small></div></div>))}
        </div>
      </>))}
    </section>

    <section class="sc-section">
      <h2 class="sc-label">Type</h2>
      <div class="sc-type">
        <span class="sc-cap"><b>h2</b> Audiowide</span><h2 class="sc-h2">A quiet view from orbit</h2>
        <span class="sc-cap"><b>h3</b> Audiowide</span><h3 class="sc-h3">Engineering log</h3>
        <span class="sc-cap"><b>h4</b> label caps</span><h4 class="sc-h4">Surfaces</h4>
        <span class="sc-cap"><b>Body</b> Rajdhani 1.2rem</span><p class="sc-body">We build small, careful things and send them a long way. This is how body text reads on our dark background.</p>
        <span class="sc-cap"><b>Small</b> 0.95rem</span><p class="sc-small">info<span class="at">@</span>enterprise-r.com · small print and captions</p>
        <span class="sc-cap"><b>Link</b></span><p class="sc-body">Read the <a class="sc-link" href="#">mission notes</a> before you start.</p>
        <span class="sc-cap"><b>Prompt</b></span><p style="margin:0"><span class="sc-prompt">Click or press</span></p>
      </div>
    </section>

    <section class="sc-section">
      <h2 class="sc-label">Cards and panels</h2>
      <div class="sc-grid cols-3">
        <div class="sc-card"><h3>Panel</h3><p>Lighter background with an inactive border. The default container.</p><span class="sc-pill">Online</span></div>
        <div class="sc-card is-active"><h3>Active</h3><p>Active border for the item in focus or selected by the user.</p><span class="sc-pill other">Standby</span></div>
        <div class="sc-card is-selected"><h3>Selection</h3><p>Selection, for a highlighted row or a chosen card: Inactive border fill with a Magenta outline.</p></div>
      </div>
      <figure class="sc-term-sample">
        <div class="sc-bd"><div class="photo" style={`background-image: url(${banner})`}></div><div class="sc-term-stack"><div class="term term-head"><div class="about-heading">Heading</div></div><div class="term"><p class="sc-body" style="margin:0">Terminal panel: a small dark backing ({hex("--ui-bg")} at 72%) that hugs a block of text on a picture, with a thin inactive border and a soft blur.</p></div></div></div>
        <figcaption class="sc-cap">Terminal panel, for text over a picture</figcaption>
      </figure>
    </section>

    <section class="sc-section">
      <h2 class="sc-label">Form</h2>
      <form class="sc-panel" onsubmit="return false">
        <div class="sc-form">
          <div class="sc-field"><label for="f-name">Name</label><input class="sc-input" id="f-name" placeholder="Jean-Luc"></div>
          <div class="sc-field"><label for="f-mail">E-mail (focus)</label><input class="sc-input is-focus" id="f-mail" type="email" value="crew@enterprise-r.com"></div>
          <div class="sc-field"><label for="f-dis">Ship ID (disabled)</label><input class="sc-input" id="f-dis" value="NCC-1701-R" disabled></div>
          <div class="sc-field"><label for="f-sel">Department</label><select class="sc-input" id="f-sel"><option>Engineering</option><option>Science</option><option>Command</option></select></div>
          <div class="sc-field" style="grid-column: span 2"><label for="f-msg">Message</label><textarea class="sc-input" id="f-msg" placeholder="Your message"></textarea></div>
          <div class="sc-field"><span class="sc-cap">Options</span><div class="sc-checks"><label><input type="checkbox" checked> Updates</label><label><input type="checkbox"> Newsletter</label></div></div>
          <div class="sc-field"><span class="sc-cap">Channel</span><div class="sc-checks"><label><input type="radio" name="ch" checked> E-mail</label><label><input type="radio" name="ch"> Subspace</label></div></div>
          <div class="sc-actions"><span class="bar-group"><button class="bar-btn primary" type="submit">Send</button><button class="bar-btn" type="button">Save</button><button class="bar-btn" type="reset">Clear</button><button class="bar-btn cancel" type="button">Cancel</button></span><span class="sc-help">Primary Green (sage), generic Orange, clear Bright blue, cancel Red.</span></div>
        </div>
      </form>
    </section>

    <section class="sc-section">
      <h2 class="sc-label">Code</h2>
      <pre class="sc-code"><code><span class="k">:root</span> {"{"}
  <span class="k">--nav-current</span>: <span class="v">var(--ui-green)</span>;         <span class="c">/* Green (sage) {hex("--ui-green")} */</span>
  <span class="k">--nav-current-hover</span>: <span class="v">var(--ui-green-bright)</span>; <span class="c">/* Bright green {hex("--ui-green-bright")} */</span>
  <span class="k">--nav-other</span>: <span class="v">var(--ui-orange)</span>;          <span class="c">/* Orange {hex("--ui-orange")} */</span>
  <span class="k">--nav-other-hover</span>: <span class="v">var(--ui-accent)</span>;    <span class="c">/* Amber (Accent) {hex("--ui-accent")} */</span>
  <span class="k">--text-body</span>: <span class="v">var(--ui-fg)</span>;        <span class="c">/* {hex("--ui-fg")} */</span>
{"}"}</code></pre>
    </section>
  </main>
  <script is:inline slot="scripts">
    // Menus: one open at a time; click outside or Esc closes them.
    (() => {
      const menus = [...document.querySelectorAll("details.bar-menu")];
      const close = (keep) => menus.forEach((m) => { if (m !== keep) m.open = false; });
      menus.forEach((m) => m.addEventListener("toggle", () => { if (m.open) close(m); }));
      document.addEventListener("click", (e) => { if (!e.target.closest("details.bar-menu")) close(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    })();
    // Label contrast, from the colours on screen.
    (() => {
      const cs = getComputedStyle(document.documentElement);
      const hex = (v) => {
        const m = v.trim().match(/^#([0-9a-f]{6})$/i);
        if (m) return "#" + m[1].toUpperCase();
        const r = v.match(/rgba?\(([^)]+)\)/);
        if (!r) return v.trim();
        return "#" + r[1].split(",").slice(0, 3).map((n) => Math.round(parseFloat(n)).toString(16).padStart(2, "0")).join("").toUpperCase();
      };
      const lum = (h) => { const c = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255).map((x) => (x <= 0.04045 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4)); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
      const ratio = (a, b) => { const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p); return ((x + 0.05) / (y + 0.05)).toFixed(1); };
      const v = (t) => hex(cs.getPropertyValue(t));
      const label = v("--nav-text");
      document.getElementById("contrast").textContent =
        `Label contrast (WCAG AA needs 4.5:1): on current ${ratio(label, v("--nav-current"))}:1, on other ${ratio(label, v("--nav-other"))}:1, ` +
        `on current hover ${ratio(label, v("--nav-current-hover"))}:1, on other hover ${ratio(label, v("--nav-other-hover"))}:1. ` +
        `Clear ${ratio(label, v("--act-clear"))}:1 (hover ${ratio(label, v("--act-clear-hover"))}:1), cancel ${ratio(label, v("--act-cancel"))}:1 (hover ${ratio(label, v("--act-cancel-hover"))}:1). ` +
        `Body text on the page background ${ratio(v("--text-body"), v("--ui-bg"))}:1.`;
    })();
  </script>
</Base>
