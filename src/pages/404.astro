---
const page = {
  title: "Page not found · Enterprise-R",
  description: "This page does not exist.",
};
const parts = [
  { text: "4", tone: "orange" },
  { text: "0", tone: "magenta" },
  { text: "4", tone: "green" },
];
// Three prompt lines. Enterprise-R is Enterprsr (that face only draws this word).
const prompts = [
  [{ text: "PAGE NOT FOUND" }],
  [{ text: "¡Br0k3n l1nk!" }],
  [
    { text: "www." },
    { text: "Enterprise-R", brand: true },
    { text: ".com" },
  ],
];

import Base from "../layouts/Base.astro";
import HomeWait from "../components/HomeWait.astro";
---
<Base title={page.title} description={page.description} noindex hero>
  <HomeWait parts={parts} prompts={prompts} sentence="404" />
</Base>
