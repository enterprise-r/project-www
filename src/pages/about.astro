---
// ✏️ EDIT THE PAGE TEXT HERE
const page = {
  title: "About · Enterprise-R",
  description: "About Enterprise-R.",
  heading: "About",
  text: "Placeholder text, to be written.",
};

import Base from "../layouts/Base.astro";
---
<Base title={page.title} description={page.description} backdrop="warpchi">
  <main class="lower-left">
    <div class="term term-head"><h1>{page.heading}</h1></div>
    <div class="term"><p class="prose">{page.text}</p></div>
  </main>
  <script is:inline slot="scripts">
    // Warm the cache with the Home logo so the way back down is ready.
    addEventListener("load", () => { new Image().src = "/assets/logo.png"; });
  </script>
</Base>
