---
// ✏️ EDIT THE PAGE TEXT HERE
const page = {
  title: "About · Enterprise-R",
  description: "About Enterprise-R.",
  heading: "One Readable Source",
  // One string per paragraph.
  text: [
    "Enterprise-R is opening the way for companies to run on AI and people, working from the same book and, as never before, by the book.",
    "Orchestration and alignment. Agents and people hand work to each other. Work speed breaks all the limits.",
  ],
};

import Base from "../layouts/Base.astro";
---
<Base title={page.title} description={page.description} backdrop="warpchi">
  <main class="lower-left">
    <div class="term term-head"><h1>{page.heading}</h1></div>
    <div class="term">{page.text.map((t) => <p class="prose">{t}</p>)}</div>
  </main>
  <script is:inline slot="scripts">
    // Warm the cache with the Home logo so the way back down is ready.
    addEventListener("load", () => { new Image().src = "/assets/logo-color.svg"; });
  </script>
</Base>
