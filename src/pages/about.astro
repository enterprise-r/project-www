---
const page = {
  title: "About · Enterprise-R",
  description: "About Enterprise-R. Contact info@enterprise-r.com.",
  heading: "1 readable source",
  email: "info@enterprise-r.com",
  // One string per paragraph.
  text: [
    "Enterprise-R is opening the way for companies to run on AI and people, working from the same book and, as never before, by the book.",
    "Orchestration and alignment. Agents and people hand work to each other. Work speed breaks all the limits.",
  ],
};

const [user, domain] = page.email.split("@");

import Base from "../layouts/Base.astro";
import "../styles/about.css";
---
<Base title={page.title} description={page.description}>
  <main class="about">
    <div class="about-stack">
      <div class="r-term term-head">
        <h1 class="about-heading">{page.heading}</h1>
      </div>
      <div class="r-term">
        {page.text.map((t) => <p>{t}</p>)}
        <p class="email">
          <a href={`mailto:${page.email}`}>{user}<span class="email-at">@</span>{domain}</a>
        </p>
      </div>
    </div>
  </main>
</Base>
